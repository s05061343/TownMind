<Window x:Class="AgePilot.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgePilot"
        Icon="Assets/Branding/agepilot.ico"
        Width="360" Height="340"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="True" ResizeMode="NoResize">
    <Border Background="#EE151713" BorderBrush="#C6A15B" BorderThickness="1"
            CornerRadius="10" Padding="16" MouseLeftButtonDown="OnDragWindow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/Branding/agepilot-logo.png" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="AgePilot" Foreground="#C6A15B" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ClickThroughButton" Content="◎" Width="26" Height="26" Click="OnToggleClickThrough"
                            ToolTip="切換滑鼠穿透（Ctrl+Shift+C）"
                            Foreground="#DDD8CC" Background="Transparent" BorderThickness="0" FontSize="15"/>
                    <Button Content="×" Width="26" Height="26" Click="OnClose"
                            Foreground="#DDD8CC" Background="Transparent" BorderThickness="0" FontSize="18"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="1" Text="正在初始化本機 OCR…"
                       Foreground="#9FA695" Margin="0,8,0,8"/>

            <Border Grid.Row="2" Background="#2A2F27" CornerRadius="6" Padding="9" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="AutomationStateText" Text="LLM 規劃預覽" Foreground="#D3A24C" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AutomationDetailText" Text="目前不會送出遊戲輸入" Foreground="#9FA695" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MilitaryStateText" Text="軍事：關閉" Foreground="#9FA695" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock x:Name="WorldStateText" Text="世界辨識：等待畫面" Foreground="#9FA695" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="AutomationToggleButton" Grid.Column="1" Content="僅預覽" Click="OnToggleAutomation" IsEnabled="False"
                            Padding="12,6" Margin="8,0,0,0" Background="#C6A15B" Foreground="#151713" BorderThickness="0" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="3" Columns="5" Margin="0,0,0,12">
                <TextBlock x:Name="WoodText" Text="W —" Foreground="#EEE9DD"/>
                <TextBlock x:Name="FoodText" Text="F —" Foreground="#EEE9DD"/>
                <TextBlock x:Name="GoldText" Text="G —" Foreground="#EEE9DD"/>
                <TextBlock x:Name="StoneText" Text="S —" Foreground="#EEE9DD"/>
                <TextBlock x:Name="PopulationText" Text="P —" Foreground="#EEE9DD"/>
            </UniformGrid>

            <Border Grid.Row="4" Background="#20241D" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="下一步" Foreground="#7FA66A" FontWeight="SemiBold"/>
                    <Button x:Name="DismissButton" Grid.Column="1" Content="略過" Click="OnDismissAdvice" Visibility="Collapsed"
                            Padding="8,2" Background="Transparent" Foreground="#9FA695" BorderBrush="#42483D"/>
                    </Grid>
                    <TextBlock x:Name="AdviceTitle" Text="等待可靠的遊戲狀態…"
                               Grid.Row="1" Foreground="#F2EDE1" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3"/>
                    <TextBlock x:Name="AdviceDescription" Text="資料不足時，AgePilot 會保持安靜。"
                               Grid.Row="2" Foreground="#C9C5BA" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OtherAdviceText" Grid.Row="3" Foreground="#9FA695" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
