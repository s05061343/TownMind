<Window x:Class="AgePilot.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgePilot" Icon="Assets/Branding/agepilot.ico" Width="720" Height="820" MinWidth="640" MinHeight="650"
        Background="#151713" Foreground="#EEE9DD" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/Branding/agepilot-logo.png" Width="52" Height="52" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="AgePilot" Foreground="#C6A15B" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="A calm companion for Age of Empires II" Foreground="#9FA695" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="#20241D" CornerRadius="8" Padding="16" Margin="0,24,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Game" Foreground="#9FA695"/><TextBlock x:Name="GameStatusText" Text="正在檢查 AOE2 DE…" FontSize="17" Margin="0,5,0,0"/></StackPanel>
                <Ellipse x:Name="GameStatusDot" Grid.Column="1" Width="12" Height="12" Fill="#D3A24C" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="HUD Profile" Foreground="#9FA695"/>
            <TextBox x:Name="ProfilePathText" Margin="0,6,0,15" Padding="8" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
            <TextBlock Text="Overlay 透明度" Foreground="#9FA695"/>
            <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,7,0,15"/>
            <TextBlock Text="掃描間隔（毫秒）" Foreground="#9FA695"/>
            <ComboBox x:Name="ScanIntervalCombo" Margin="0,6,0,0" Padding="6">
                <ComboBoxItem Content="250"/><ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/><ComboBoxItem Content="2000"/>
            </ComboBox>
            <CheckBox x:Name="SessionRecordingCheck" Content="儲存本機對局紀錄（SQLite）" Margin="0,14,0,0" Foreground="#EEE9DD"/>
            <CheckBox x:Name="LocalDiagnosticsCheck" Content="儲存本機診斷事件（JSONL）" Margin="0,8,0,0" Foreground="#EEE9DD"/>
            <Separator Margin="0,20,0,14" Background="#42483D"/>
            <TextBlock Text="LLM 規劃預覽" Foreground="#C6A15B" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="目前只顯示同一份 LLM 戰局計畫，不會送出任何遊戲輸入。"
                       Foreground="#9FA695" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <Border Background="#20241D" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="LlmStatusDot" Width="10" Height="10" Fill="#D3A24C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="LlmStatusText" Grid.Column="1" Text="LLM：尚未測試" Foreground="#C9C5BA" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="TestLlmButton" Grid.Column="2" Content="測試 LLM" Click="OnTestLlm" Padding="12,5" Margin="10,0,0,0" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
                </Grid>
            </Border>
            <TextBlock Text="llama.cpp Runtime 目錄" Foreground="#9FA695"/>
            <Grid Margin="0,5,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="LlamaRuntimePathText" Padding="7" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
                <Button Grid.Column="1" Content="選擇目錄" Click="OnBrowseLlamaRuntime" Padding="12,6" Margin="8,0,0,0" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
            </Grid>
            <TextBlock Text="GGUF 模型檔" Foreground="#9FA695"/>
            <Grid Margin="0,5,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="LlmModelPathText" Padding="7" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
                <Button Grid.Column="1" Content="選擇模型" Click="OnBrowseLlmModel" Padding="12,6" Margin="8,0,0,0" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
            </Grid>
            <TextBlock Text="視覺編碼器 mmproj" Foreground="#9FA695"/>
            <Grid Margin="0,5,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="VisionProjectorPathText" Padding="7" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
                <Button Grid.Column="1" Content="選擇 mmproj" Click="OnBrowseVisionProjector" Padding="12,6" Margin="8,0,0,0" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
            </Grid>
            <TextBlock Text="以下舊自動操作設定暫時停用。" Foreground="#9FA695" Margin="0,0,0,8"/>
            <CheckBox x:Name="AutomationInputCheck" Content="允許 Ctrl+F10 從全域熱鍵啟用；Overlay 按鈕仍可直接授權本局（Ctrl+F12 緊急停止）"
                      Foreground="#EEE9DD" Margin="0,0,0,10"/>
            <Grid IsEnabled="False" Opacity="0.55">
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="開啟熱鍵" VerticalAlignment="Center" Foreground="#C9C5BA"/>
                <TextBox x:Name="AutomationStartHotKeyText" Grid.Column="1" Padding="6" Margin="0,3" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
                <TextBlock Grid.Column="3" Text="緊急關閉熱鍵" VerticalAlignment="Center" Foreground="#C9C5BA"/>
                <TextBox x:Name="AutomationStopHotKeyText" Grid.Column="4" Padding="6" Margin="0,3" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>

                <TextBlock Grid.Row="1" Text="村民生產序列" VerticalAlignment="Center" Foreground="#C9C5BA"/>
                <TextBox x:Name="VillagerSequenceText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Padding="6" Margin="0,3" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D" ToolTip="預設 H,Q：選擇城鎮中心後排入村民"/>

                <CheckBox x:Name="MilitaryAutomationCheck" Grid.Row="2" Grid.ColumnSpan="5" Content="加入軍事操作（只執行下方非空白序列）" Margin="0,9,0,5" Foreground="#EEE9DD"/>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="5">
                    <TextBlock Text="軍營序列" Foreground="#9FA695"/>
                    <TextBox x:Name="BarracksSequenceText" Padding="6" Margin="0,3,0,6" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
                    <TextBlock Text="靶場序列" Foreground="#9FA695"/>
                    <TextBox x:Name="ArcheryRangeSequenceText" Padding="6" Margin="0,3,0,6" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
                    <TextBlock Text="馬廄序列" Foreground="#9FA695"/>
                    <TextBox x:Name="StableSequenceText" Padding="6" Margin="0,3,0,0" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
                    <TextBlock Text="閒置村民選取序列" Foreground="#9FA695" Margin="0,8,0,0"/>
                    <TextBox x:Name="IdleVillagerSequenceText" Padding="6" Margin="0,3,0,6" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
                    <TextBlock Text="房屋／市場／鐵匠鋪序列" Foreground="#9FA695"/>
                    <Grid Margin="0,3,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox x:Name="HouseSequenceText" Padding="6" Margin="0,0,4,0" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D" ToolTip="房屋"/>
                        <TextBox x:Name="MarketSequenceText" Grid.Column="1" Padding="6" Margin="2,0" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D" ToolTip="市場"/>
                        <TextBox x:Name="BlacksmithSequenceText" Grid.Column="2" Padding="6" Margin="4,0,0,0" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D" ToolTip="鐵匠鋪"/>
                    </Grid>
                    <TextBlock Text="封建／城堡升級序列" Foreground="#9FA695"/>
                    <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FeudalUpgradeSequenceText" Padding="6" Margin="0,0,4,0" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D" ToolTip="升封建"/>
                        <TextBox x:Name="CastleUpgradeSequenceText" Grid.Column="1" Padding="6" Margin="4,0,0,0" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D" ToolTip="升城堡"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <Separator Margin="0,20,0,14" Background="#42483D"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="最近對局" Foreground="#C6A15B" FontSize="16" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="匯出診斷" Click="OnExportDiagnostics" Padding="10,4" Margin="0,0,8,0" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
                    <Button Content="重新整理" Click="OnRefreshHistory" Padding="10,4" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="RecentSessionsText" Text="尚無對局紀錄。" Margin="0,10,0,0" Foreground="#C9C5BA" TextWrapping="Wrap" LineHeight="20"/>
            <Separator Margin="0,18,0,12" Background="#42483D"/>
            <TextBlock Text="Live Diagnostics" Foreground="#C6A15B" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="DiagnosticsText" Text="Overlay 尚未啟動。" Margin="0,8,0,0" Foreground="#C9C5BA" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" Foreground="#9FA695" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="儲存設定" Click="OnSaveSettings" Padding="18,9" Margin="0,0,10,0" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
            <Button x:Name="OverlayButton" Grid.Column="2" Content="啟動 Overlay" Click="OnToggleOverlay" Padding="22,9" Background="#C6A15B" Foreground="#151713" BorderThickness="0" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
