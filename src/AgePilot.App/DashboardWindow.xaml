<Window x:Class="AgePilot.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgePilot" Width="680" Height="650" MinWidth="600" MinHeight="560"
        Background="#151713" Foreground="#EEE9DD" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="AgePilot" Foreground="#C6A15B" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="A calm companion for Age of Empires II" Foreground="#9FA695" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#20241D" CornerRadius="8" Padding="16" Margin="0,24,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Game" Foreground="#9FA695"/><TextBlock x:Name="GameStatusText" Text="正在檢查 AOE2 DE…" FontSize="17" Margin="0,5,0,0"/></StackPanel>
                <Ellipse x:Name="GameStatusDot" Grid.Column="1" Width="12" Height="12" Fill="#D3A24C" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="HUD Profile" Foreground="#9FA695"/>
            <TextBox x:Name="ProfilePathText" Margin="0,6,0,15" Padding="8" Background="#20241D" Foreground="#EEE9DD" BorderBrush="#42483D"/>
            <TextBlock Text="Overlay 透明度" Foreground="#9FA695"/>
            <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,7,0,15"/>
            <TextBlock Text="掃描間隔（毫秒）" Foreground="#9FA695"/>
            <ComboBox x:Name="ScanIntervalCombo" Margin="0,6,0,0" Padding="6">
                <ComboBoxItem Content="250"/><ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/><ComboBoxItem Content="2000"/>
            </ComboBox>
            <CheckBox x:Name="SessionRecordingCheck" Content="儲存本機對局紀錄（SQLite）" Margin="0,14,0,0" Foreground="#EEE9DD"/>
            <CheckBox x:Name="LocalDiagnosticsCheck" Content="儲存本機診斷事件（JSONL）" Margin="0,8,0,0" Foreground="#EEE9DD"/>
            <Separator Margin="0,20,0,14" Background="#42483D"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="最近對局" Foreground="#C6A15B" FontSize="16" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="匯出診斷" Click="OnExportDiagnostics" Padding="10,4" Margin="0,0,8,0" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
                    <Button Content="重新整理" Click="OnRefreshHistory" Padding="10,4" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="RecentSessionsText" Text="尚無對局紀錄。" Margin="0,10,0,0" Foreground="#C9C5BA" TextWrapping="Wrap" LineHeight="20"/>
            <Separator Margin="0,18,0,12" Background="#42483D"/>
            <TextBlock Text="Live Diagnostics" Foreground="#C6A15B" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="DiagnosticsText" Text="Overlay 尚未啟動。" Margin="0,8,0,0" Foreground="#C9C5BA" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" Foreground="#9FA695" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="儲存設定" Click="OnSaveSettings" Padding="18,9" Margin="0,0,10,0" Background="#42483D" Foreground="#EEE9DD" BorderThickness="0"/>
            <Button x:Name="OverlayButton" Grid.Column="2" Content="啟動 Overlay" Click="OnToggleOverlay" Padding="22,9" Background="#C6A15B" Foreground="#151713" BorderThickness="0" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
